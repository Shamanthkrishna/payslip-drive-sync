# Paybooks credentials
# Copy this file to .env and fill in your actual credentials

PAYBOOKS_LOGIN_ID=your_login_id_here
PAYBOOKS_PASSWORD=your_password_here
PAYBOOKS_DOMAIN=your_company_domain_here
PAYBOOKS_URL=https://apps.paybooks.in/

# Google Drive settings
GOOGLE_DRIVE_ROOT_FOLDER=Pay Slips

# Optional tuning
# If cached token age is less than this, browser login is skipped.
PAYBOOKS_TOKEN_CACHE_HOURS=72

# Set to false only for interactive debugging (slower, opens browser window).
HEADLESS_MODE=true
